# ---------------------------------------------------------------------------
# Optional overrides for docker-compose.yml.
#
# Every value below is already the default in docker-compose.yml, so the stack
# runs without a .env file. To change something, copy this file to .env (which
# git ignores) and edit it:
#
#   cp .env.example .env
#
# Nothing secret belongs here: the object-store key is generated on first boot
# and lives only in the garage-creds Docker volume.
# ---------------------------------------------------------------------------

# Image tags. All are multi-arch, including arm64 / Apple Silicon.
GARAGE_IMAGE=dxflrs/garage:v2.1.0
POSTGRES_IMAGE=postgres:16-alpine
POLARIS_IMAGE=apache/polaris:1.8.0
# Tag of apache/polaris-admin-tool; keep it in step with POLARIS_IMAGE.
POLARIS_VERSION=1.8.0
TRINO_IMAGE=trinodb/trino:477
# Spark and Iceberg versions are set in config/jupyter/Dockerfile, not here.

# Object storage (Garage speaks the S3 API)
S3_ENDPOINT=http://objectstore:3900
S3_REGION=us-east-1
S3_BUCKET=warehouse

# Polaris catalog. Must include the /api/catalog prefix -- Polaris serves the
# Iceberg REST catalog there, and without it Trino probes /v1/config and gets 404.
POLARIS_URI=http://polaris:8181/api/catalog
POLARIS_CATALOG=lakehouse
POLARIS_REALM=POLARIS
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=root
